{
  "name": "agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm start",
    "start": "tsx watch --include .env src/index.ts",
    "start:once": "tsx src/index.ts",
    "build": "tsc",
    "test": "tsx --test src/cli-events.test.ts src/im/lark.test.ts src/im/message-parser.test.ts src/im/card.test.ts src/core/session-manager.test.ts src/core/command-parser.test.ts",
    "probe:cli": "tsx src/probe-cli.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "dotenv": "^17.2.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.32.1"
}
