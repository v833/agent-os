# bot 注册文件路径；默认读取 config/bots.json
BOTS_CONFIG=config/bots.json

# 飞书凭证变量名由 bots.json 中的 appIdEnv / appSecretEnv 决定
FEISHU_DEVELOPER_APP_ID=cli_xxx
FEISHU_DEVELOPER_APP_SECRET=xxx
FEISHU_REVIEWER_APP_ID=cli_xxx
FEISHU_REVIEWER_APP_SECRET=xxx
FEISHU_ASSISTANT_APP_ID=cli_xxx
FEISHU_ASSISTANT_APP_SECRET=xxx

# 测试话题群 chat_id（把 bot 拉进群后获取）
TEST_CHAT_ID=oc_xxx

# 自己的飞书 open_id；先运行机器人并从 sender= 日志中取得
OWNER_OPEN_ID=ou_xxx

# Mastra Agent 引擎（defaultCli: "mastra" 或 /mastra <任务> 时使用）
# 模型路由：<provider>/<model>，如 openai/gpt-5.6-sol、anthropic/claude-sonnet-4-6、
# deepseek/deepseek-chat、alibaba-cn/qwen-plus；API Key 使用对应 provider 的标准环境变量
# （OPENAI_API_KEY / ANTHROPIC_API_KEY / DEEPSEEK_API_KEY / DASHSCOPE_API_KEY ...）
MASTRA_MODEL=
# 可选：Mastra Agent 的系统提示词，留空使用内置默认角色
MASTRA_SYSTEM_PROMPT=

# 兼容旧配置：bot 未填写 workspace 时作为默认项目目录
# 新配置请在 config/bots.json 的每个 bot 上填写 workspace
CLI_WORKDIR=

# Claude Code / Codex 的模型后端使用各自的用户级配置管理
# 也可以使用 CC Switch 在不同模型服务之间切换
